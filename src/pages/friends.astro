---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { friendLinks } from "@/data/friends";

const getHostname = (link: string) => {
	try {
		return new URL(link).hostname.replace(/^www\./, "");
	} catch {
		return link;
	}
};
---

<MainGridLayout title="友链" description="朋友们的博客与个人站点">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 md:px-9 py-7 relative w-full" data-pagefind-body>
			<div class="mb-7">
				<h1 class="text-3xl font-bold text-black/90 dark:text-white/90 mb-2 transition">友链</h1>
			</div>

			{friendLinks.length > 0 ? (
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{friendLinks.map((friend) => (
						<a
							href={friend.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group transition rounded-2xl border border-black/10 dark:border-white/10 bg-black/[0.025] dark:bg-white/[0.035] hover:bg-[var(--btn-regular-bg-hover)] active:scale-[0.98] p-4 flex items-center gap-4"
						>
							<div class="w-16 h-16 shrink-0 rounded-2xl overflow-hidden bg-black/5 dark:bg-white/10 flex items-center justify-center">
								{friend.avatar ? (
									<img
										src={friend.avatar}
										alt={`${friend.name} 的头像`}
										loading="lazy"
										referrerpolicy="no-referrer"
										class="w-full h-full object-cover"
									/>
								) : (
									<Icon name="material-symbols:person-rounded" class="text-4xl text-black/30 dark:text-white/30 transition" />
								)}
							</div>

							<div class="min-w-0 grow">
								<div class="flex items-center gap-2 mb-1">
									<h2 class="font-bold text-lg text-black/90 dark:text-white/90 truncate group-hover:text-[var(--primary)] transition">
										{friend.name}
									</h2>
									<Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs text-black/30 dark:text-white/30 shrink-0 transition" />
								</div>
								<p class="text-sm text-black/60 dark:text-white/60 line-clamp-2 mb-1 transition">{friend.description}</p>
								<p class="text-xs text-black/35 dark:text-white/35 truncate transition">{getHostname(friend.url)}</p>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="rounded-2xl border border-dashed border-black/10 dark:border-white/10 px-6 py-12 text-center text-black/50 dark:text-white/50 transition">
					友链正在整理中。
				</div>
			)}
		</div>
	</div>
</MainGridLayout>
